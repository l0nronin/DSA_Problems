class TimeMap {
    private Map<String,List<Pair<String,Integer>>> hashmap;
    public TimeMap() {
        hashmap = new HashMap<>();
    }
    
    public void set(String key, String value, int timestamp) {
            hashmap.computeIfAbsent(key, k -> new ArrayList<>()).add(new Pair<>(value,timestamp));
    }
    
    public String get(String key, int timestamp) {
        if (!hashmap.containsKey(key)) {
            return "";}
        List<Pair<String,Integer>> values = hashmap.get(key);
        int l = 0;
        int r = values.size() -1;
        int ans = -1;
        while(l <= r){
            int mid = l + (r-l)/2;
            if(values.get(mid).getValue() == timestamp){
                return values.get(mid).getKey();
            }
            if(values.get(mid).getValue() <= timestamp){
                ans = mid;
                l = mid+1;
            }else{
                r = mid -1;
            }
        }
        if(ans > -1){
            return values.get(ans).getKey();
        }else{
            return "";
        }
    }
    public static class Pair<k,v>{
        private final k key;
        private final v value;
        Pair(k key,v val){
            this.key = key;
            this.value = val;
        }
        public k getKey(){
            return this.key;
        }
        public v getValue(){
            return this.value;
        }
    }
}
